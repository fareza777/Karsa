{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/p/:slug", "destination": "/api/site/:slug" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "functions": {
    "api/chat.js": { "maxDuration": 300 },
    "api/publish.js": { "maxDuration": 60 },
    "api/site/[slug].js": { "maxDuration": 30 },
    "api/domain.js": { "maxDuration": 15 },
    "api/config.js": { "maxDuration": 10 },
    "api/verify-pro.js": { "maxDuration": 10 },
    "api/setup-auth.js": { "maxDuration": 30 },
    "api/lemon-webhook.js": { "maxDuration": 30 },
    "api/verify-license.js": { "maxDuration": 15 },
    "api/superuser-sync.js": { "maxDuration": 15 },
    "api/analytics-event.js": { "maxDuration": 10 },
    "api/admin-analytics.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
