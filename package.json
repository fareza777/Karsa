{
  "name": "karsa",
  "version": "1.0.0",
  "private": true,
  "description": "KARSA — pembuat aplikasi berbasis browser (vibecoding)",
  "scripts": {
    "generate-og": "node scripts/generate-og-images.mjs",
    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "generate-feed": "node scripts/generate-feed.mjs",
    "generate-seo": "node scripts/generate-og-images.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-feed.mjs",
    "stamp": "node scripts/stamp-version.mjs",
    "build": "npm run generate-seo && npm run stamp",
    "e2e": "node scripts/e2e-workflow.mjs",
    "smoke": "node scripts/smoke-serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/check-syntax.mjs"
  },
  "devDependencies": {
    "vitest": "^2.1.9"
  }
}
